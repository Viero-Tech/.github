{
  "name": "copilot-review-and-branch-protection",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev", "refs/heads/staging"],
      "exclude": []
    },
    "repository_name": {
      "include": ["*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": false
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "require_code_owner_review": true
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_type": "Team",
      "actor_id": 16776945,
      "bypass_mode": "pull_request"
    }
  ]
}
